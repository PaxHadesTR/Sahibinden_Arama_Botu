# ==========================================
# Sahibinden Discord Alert Bot Configuration
# ==========================================

# Discord Bot Token (Get from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Optional: Instant slash command synchronization for your specific Discord Server/Guild ID
# DISCORD_GUILD_ID=123456789012345678

# Polling interval in seconds between check cycles (recommended: 60 - 180)
CHECK_INTERVAL_SECONDS=90

# Browser Channel ('msedge' or 'chrome' or leave empty for default chromium)
BROWSER_CHANNEL=msedge

# Run browser in headless mode (False with minimized window is recommended to bypass Cloudflare)
HEADLESS=False

# Optional: HTTP/SOCKS5 Proxy for stealth IP rotation (e.g. http://user:pass@host:port)
# PROXY_URL=
