# ==========================================
# Sahibinden Discord Alert Bot Configuration
# ==========================================

# ------------------------------------------
# 1. Discord Bot Credentials
# ------------------------------------------
# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Optional: Instant slash command sync for your specific Guild/Server ID (avoids 1hr global sync wait)
# DISCORD_GUILD_ID=123456789012345678

# ------------------------------------------
# 2. Turkey Discord Access / Cloudflare WARP Proxy (YÖNTEM A)
# ------------------------------------------
# Set to 'true' in Turkey so Discord API/Gateway bypasses the BTK block.
# NOTE: This only proxies Discord traffic. Sahibinden scraping traffic remains on
# your direct Turkish residential IP so Sahibinden does NOT block it!
USE_WARP=true

# WARP Proxy Host (127.0.0.1 for Yöntem A / network_mode: host with WSL warp-cli)
WARP_HOST=127.0.0.1

# Default warp-cli SOCKS5 port
WARP_PORT=40000

# Optional explicit proxy URL (Overrides USE_WARP if set, e.g. socks5://127.0.0.1:40000)
# DISCORD_PROXY_URL=

# ------------------------------------------
# 3. Scraping & Browser Settings
# ------------------------------------------
# Polling interval in seconds between check cycles (Recommended: 60 - 180)
CHECK_INTERVAL_SECONDS=90

# Scraper timeout per page load (seconds)
SCRAPER_TIMEOUT_SECONDS=35

# Browser Channel:
# - In Docker / Coolify / Linux: leave EMPTY to use standard Chromium on Xvfb
# - On Windows host: 'msedge' or 'chrome' or empty
BROWSER_CHANNEL=

# Headless mode:
# - In Docker / Coolify: False (runs on Xvfb virtual display :99 to bypass Cloudflare Turnstile)
# - On Windows: False (runs minimized)
HEADLESS=false

# Optional Proxy for Sahibinden.com scraping ONLY (Must be a Turkish residential proxy if used)
# PROXY_URL=http://user:pass@host:port

# ------------------------------------------
# 4. Anti-Bot Jitter
# ------------------------------------------
MIN_JITTER_SECONDS=3.0
MAX_JITTER_SECONDS=8.0
