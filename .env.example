# ==========================================
# Sahibinden Discord Alert Bot Configuration
# ==========================================

# ------------------------------------------
# 1. Discord Bot Credentials
# ------------------------------------------
# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Optional: Instant slash command sync for your specific Guild/Server ID (avoids 1hr global sync wait)
# DISCORD_GUILD_ID=123456789012345678

# ------------------------------------------
# 2. Turkey Discord Access / Cloudflare WARP Proxy
# ------------------------------------------
# Set to 'true' in Turkey or any region where Discord is blocked by ISP / BTK.
# NOTE: This only proxies Discord API & Gateway traffic. Sahibinden scraping traffic
# remains on your direct Turkish residential IP so Sahibinden does NOT block it!
USE_WARP=false

# WARP Proxy Host:
# - If using WSL host warp-cli with network_mode: host -> 127.0.0.1
# - If using Docker bridge network to WSL host -> host.docker.internal
# - If using Coolify / Docker Compose WARP sidecar -> warp
WARP_HOST=127.0.0.1

# WARP Proxy Port:
# - Default warp-cli SOCKS5 port: 40000
# - Coolify / caomingjun/warp sidecar port: 1080
WARP_PORT=40000

# Optional explicit proxy URL (Overrides USE_WARP if set, e.g. socks5://127.0.0.1:40000 or http://proxy:8080)
# DISCORD_PROXY_URL=

# ------------------------------------------
# 3. Scraping & Browser Settings
# ------------------------------------------
# Polling interval in seconds between check cycles (Recommended: 60 - 180)
CHECK_INTERVAL_SECONDS=90

# Scraper timeout per page load (seconds)
SCRAPER_TIMEOUT_SECONDS=35

# Browser Channel:
# - On Windows host: 'msedge' or 'chrome' or empty for chromium
# - In Docker / Coolify / Linux: leave EMPTY to use standard Chromium
BROWSER_CHANNEL=

# Headless mode:
# - On Windows: False (runs minimized to evade Cloudflare Turnstile)
# - In Docker / Coolify: False (runs on Xvfb virtual display :99)
HEADLESS=false

# Optional Proxy for Sahibinden.com scraping ONLY (Must be a Turkish residential proxy if used)
# PROXY_URL=http://user:pass@host:port

# ------------------------------------------
# 4. Anti-Bot Jitter
# ------------------------------------------
MIN_JITTER_SECONDS=3.0
MAX_JITTER_SECONDS=8.0
