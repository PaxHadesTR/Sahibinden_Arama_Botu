# ==========================================
# Sahibinden Discord Alert Bot Configuration
# ==========================================

# ------------------------------------------
# 1. Discord Bot Credentials
# ------------------------------------------
# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Optional: Instant slash command sync for your specific Guild/Server ID (avoids 1hr global sync wait)
# DISCORD_GUILD_ID=123456789012345678

# Optional: Extra Discord User IDs (comma-separated) allowed to run /cookie-yukle & /cookie-durum
# Note: The Discord Bot Owner is automatically authorized even if this is left empty.
# ADMIN_USER_IDS=123456789012345678,987654321098765432

# ------------------------------------------
# 2. Turkey Discord Access / Dual-Proxy Failover (SpoofDPI + Cloudflare WARP)
# ------------------------------------------
# In Turkey, Discord is blocked by ISPs (BTK/DPI), resulting in SSLCertVerificationError.
# Recommended zero-drop dual-proxy failover: SpoofDPI primary + hardened Cloudflare WARP backup.
# Both sidecar services + autoheal are preconfigured in docker-compose.yml.
# NOTE: This ONLY proxies Discord API/Gateway traffic. Sahibinden.com scraping traffic
# ALWAYS remains on your direct Turkish residential IP so Sahibinden does NOT block it!
DISCORD_PROXY=http://spoof-dpi:8080,http://warp:1080

# If all configured proxies fail consecutively, probe direct connection before rotating back.
# Set to 'false' on Turkey/BTK-blocked servers (avoids wasted blocked SSL probes);
# set to 'true' on non-blocked EU/US VPS hosts for automatic direct self-healing.
DISCORD_PROXY_FALLBACK_DIRECT=false
DISCORD_PROXY_FAILOVER_THRESHOLD=2

# Legacy single-WARP settings (only used when DISCORD_PROXY and DISCORD_PROXY_URL are empty)
# USE_WARP=false
# WARP_HOST=warp
# WARP_PORT=1080
# WARP_FALLBACK_TO_DIRECT=false

# Optional explicit proxy override (takes precedence over DISCORD_PROXY and USE_WARP; supports comma-separated list)
# DISCORD_PROXY_URL=

# ------------------------------------------
# 3. Scraping & Browser Settings
# ------------------------------------------
# Polling interval in seconds between check cycles (Recommended: 60 - 180)
CHECK_INTERVAL_SECONDS=90

# Scraper timeout per page load (seconds)
SCRAPER_TIMEOUT_SECONDS=35

# Browser Channel:
# - In Docker / Coolify / Linux: leave EMPTY to use standard Chromium on Xvfb
# - On Windows host: 'msedge' or 'chrome' or empty
BROWSER_CHANNEL=

# Headless mode:
# - In Docker / Coolify: False (runs on Xvfb virtual display :99 to bypass Cloudflare Turnstile)
# - On Windows: False (runs minimized)
HEADLESS=false

# Optional Proxy for Sahibinden.com scraping ONLY (Must be a Turkish residential proxy if used)
# PROXY_URL=http://user:pass@host:port

# Optional: Path to your own Sahibinden browser session cookies file
# Supports raw DevTools 'Cookie:' header text, {"cookie_header": "..."}, or Playwright storage_state.json.
# Hot-reloaded automatically on change. Used when Sahibinden redirects to secure.sahibinden.com/giris.
# SAHIBINDEN_COOKIES_PATH=/app/data/sahibinden_cookies.json

# Base cooldown (in seconds) when Sahibinden redirects to /giris login wall (scales 1x -> 3x -> 6x)
LOGIN_WALL_COOLDOWN_SECONDS=300

# ------------------------------------------
# 4. Anti-Bot Jitter
# ------------------------------------------
MIN_JITTER_SECONDS=3.0
MAX_JITTER_SECONDS=8.0

# ------------------------------------------
# 5. Alarm Creation Limits
# ------------------------------------------
# Optimum: 1000 (Döngü süresi ve tek IP sağlığı için optimum değer. İsterseniz 10000 yapabilirsiniz).
MAX_ALARMS_TOTAL=1000

# Kullanıcı başına izin verilen maksimum alarm sayısı
MAX_ALARMS_PER_USER=100
